server {
    listen 80;
    server_name _;
    include /etc/nginx/augenblick-locations.conf;
}
server {
    listen 8443 ssl;
    server_name _;
    ssl_certificate ${SSL_CERTIFICATE};
    ssl_certificate_key ${SSL_CERTIFICATE_KEY};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:TLS:1m;
    ssl_session_timeout 10m;
    include /etc/nginx/augenblick-locations.conf;
}
