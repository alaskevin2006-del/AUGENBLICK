FROM python:3.13-slim
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
WORKDIR /app
COPY platform/src/backend/requirements.txt .
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN pip install --no-cache-dir --timeout 30 --retries 2 --index-url "$PIP_INDEX_URL" -r requirements.txt
COPY platform/src/backend/ .
COPY platform/deploy/healthcheck.py /app/healthcheck.py
RUN groupadd --gid 10001 app && useradd --uid 10001 --gid app --no-create-home app \
    && mkdir -p /data/media && chown app:app /data/media
USER app
EXPOSE 8000
# Migrations run explicitly before deployment, never on automatic restarts.
CMD ["gunicorn", "config.wsgi:application", "--bind", "0.0.0.0:8000", "--workers", "2", "--timeout", "180", "--access-logfile", "-", "--error-logfile", "-"]
