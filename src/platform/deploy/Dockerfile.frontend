FROM node:22-slim AS build
WORKDIR /repo
COPY znawca/src ./znawca/src
COPY platform/src/frontend ./platform/src/frontend
WORKDIR /repo/platform/src/frontend
RUN npm ci && npm run build

FROM nginx:stable-alpine
COPY --from=build /repo/platform/src/frontend/dist /usr/share/nginx/html
COPY platform/deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY platform/deploy/nginx-locations.conf /etc/nginx/augenblick-locations.conf
EXPOSE 80 8443
