# 后端镜像：Django 5.2 + gunicorn + WhiteNoise（媒体 /media/）
# 构建上下文：AUGENBLICK/src（需含 platform/src/backend）
FROM python:3.13-slim

ENV PYTHONUNBUFFERED=1
WORKDIR /app

COPY platform/src/backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY platform/src/backend/ .

ENV DJANGO_DEBUG=0 \
    DJANGO_ALLOWED_HOSTS=* \
    DB_ENGINE=postgresql \
    DB_NAME=augenblick \
    DB_USER=augenblick \
    DB_HOST=db \
    DB_PORT=5432 \
    MEDIA_ROOT=/data/media

RUN mkdir -p /data/media

EXPOSE 8000
# 启动先迁移；课程导入另行执行：docker compose exec backend python manage.py import_znawca /courses/<目录>
CMD ["sh", "-c", "python manage.py migrate --noinput && gunicorn config.wsgi:application --bind 0.0.0.0:8000 --workers 3"]
